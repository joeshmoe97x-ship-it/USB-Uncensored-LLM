#!/usr/bin/env bash
# ----------------------------------------------------------------------------
# Provenance: introduced by `935d9dc` (single-commit file, audit-chain adoption v1.10).
# Tripod Closure: see `../docs/ops-notes.md` ## Operational notes (host-shell tooling workflow).
# Anchor Covenant (Regex): strictly bonds to `/tmp/test*_body.ts` file globs (find -maxdepth 3 -type f -name 'test*_body.ts' ! -path '*/node_modules/*').
# Disambiguation: pre-commit hook fires only on `git commit`; bypass via `--no-verify` is git-side, not script-side.
# Tag Chain: synced with audit-cycle tag chain.
# ----------------------------------------------------------------------------
# Fail pre-commit if /tmp/test*_body.ts staging mirrors exist.
# Staging mirrors invite drift between /tmp/ draft copies and the live
# camaras/tests/e2e/<spec>.ts; once the same content lands in the spec
# (md5-verified or equivalent), the staging copy must be deleted in the
# same commit.
set -euo pipefail

LEAKS=$(find /tmp -maxdepth 3 -type f -name 'test*_body.ts' ! -path '*/node_modules/*' 2>/dev/null || true)
if [ -n "${LEAKS:-}" ]; then
  echo "pre-commit: stale /tmp/test*_body.ts staging mirror(s) detected:" >&2
  printf '%s\n' "$LEAKS" >&2
  echo "Delete them (after verifying md5 match against the live spec) before committing." >&2
  exit 1
fi

exit 0

# v3.1.5.3: MANUALCHANGES-VS-USER-SPEC drift warning (informational)
# See `../scripts/check-manual-drift.sh` for the drift anchor registry.
# Pre-commit mode = developer-feedback layer only (no hard-fail).
# The HARD-FAIL gate fires in `commit-msg` mode (after this script returns).
MODE=pre-commit CURRENT_FILE="$(git rev-parse --show-toplevel 2>/dev/null)/audit_script.sh" \
  bash "$(git rev-parse --show-toplevel 2>/dev/null)/app/scripts/check-manual-drift.sh" || true
